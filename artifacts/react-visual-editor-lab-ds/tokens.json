{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format, extracted from the React Visual Editor Torture Test. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit generated outputs. The system is dark-first, technical, compact, and built around high-contrast source-mapping fixtures.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#fcfbf8" },
      "foreground": { "$value": "#1e2639" },
      "border": { "$value": "#c3c8d5" },
      "card": { "$value": "#fcfbf8" },
      "cardForeground": { "$value": "#1e2639" },
      "popover": { "$value": "#fcfbf8" },
      "popoverForeground": { "$value": "#1e2639" },
      "primary": {
        "$value": "#f2642c",
        "$description": "Warm orange emphasis for primary actions, active filters, source accents, and focus rings."
      },
      "primaryForeground": { "$value": "#fcfbf8" },
      "secondary": { "$value": "#39937b" },
      "secondaryForeground": { "$value": "#151b28" },
      "muted": { "$value": "#d5d9e2" },
      "mutedForeground": { "$value": "#58637e" },
      "accent": { "$value": "#f9cd48" },
      "accentForeground": { "$value": "#1e2639" },
      "destructive": { "$value": "#dd382c" },
      "destructiveForeground": { "$value": "#fcfbf8" },
      "input": { "$value": "#c3c8d5" },
      "ring": { "$value": "#f2642c" },
      "chart1": { "$value": "#f2642c" },
      "chart2": { "$value": "#39937b" },
      "chart3": { "$value": "#1e2639" },
      "chart4": { "$value": "#f9cd48" },
      "chart5": { "$value": "#dd382c" },
      "sidebar": { "$value": "#161d2d" },
      "sidebarForeground": { "$value": "#f9f7f1" },
      "sidebarBorder": { "$value": "#2a3246" },
      "sidebarPrimary": { "$value": "#f2642c" },
      "sidebarPrimaryForeground": { "$value": "#151b28" },
      "sidebarAccent": { "$value": "#242b3d" },
      "sidebarAccentForeground": { "$value": "#f9f7f1" },
      "sidebarRing": { "$value": "#f2642c" }
    },
    "dark": {
      "background": { "$value": "#151b28" },
      "foreground": { "$value": "#f9f7f1" },
      "border": { "$value": "#3f475a" },
      "card": { "$value": "#1e2533" },
      "cardForeground": { "$value": "#f9f7f1" },
      "popover": { "$value": "#1e2533" },
      "popoverForeground": { "$value": "#f9f7f1" },
      "primary": { "$value": "#f3723f" },
      "primaryForeground": { "$value": "#151b28" },
      "secondary": { "$value": "#39937b" },
      "secondaryForeground": { "$value": "#f9f7f1" },
      "muted": { "$value": "#323948" },
      "mutedForeground": { "$value": "#d3c392" },
      "accent": { "$value": "#f8c220" },
      "accentForeground": { "$value": "#151b28" },
      "destructive": { "$value": "#af261d" },
      "destructiveForeground": { "$value": "#f9f7f1" },
      "input": { "$value": "#3f475a" },
      "ring": { "$value": "#f3723f" },
      "chart1": { "$value": "#f3723f" },
      "chart2": { "$value": "#39937b" },
      "chart3": { "$value": "#f9cd48" },
      "chart4": { "$value": "#4f6596" },
      "chart5": { "$value": "#dd382c" },
      "sidebar": { "$value": "#0f141f" },
      "sidebarForeground": { "$value": "#f9f7f1" },
      "sidebarBorder": { "$value": "#2a3246" },
      "sidebarPrimary": { "$value": "#f3723f" },
      "sidebarPrimaryForeground": { "$value": "#151b28" },
      "sidebarAccent": { "$value": "#242b3d" },
      "sidebarAccentForeground": { "$value": "#f9f7f1" },
      "sidebarRing": { "$value": "#f3723f" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Space Grotesk", "sans-serif"],
        "$description": "Geometric display and UI face used for headings, labels, and compact controls."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": {
        "$value": ["IBM Plex Mono", "monospace"],
        "$description": "Technical metadata, IDs, source patterns, and instrumentation labels."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Base 8px radius; controls use a tighter 5px treatment while cards use the base radius."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
